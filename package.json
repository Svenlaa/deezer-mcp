{
    "name": "deezer-mcp",
    "version": "1.0.0",
    "description": "MCP server for Deezer — now playing, queue, listening history, search, lyrics, favorites, playlists and discovery via the pipe GraphQL API",
    "type": "module",
    "bin": {
        "deezer-mcp": "./src/index.ts"
    },
    "scripts": {
        "start": "node src/index.ts",
        "dev": "node --watch src/index.ts",
        "test": "node --test test/"
    },
    "keywords": [
        "mcp",
        "deezer",
        "music",
        "now-playing"
    ],
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.16.1",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6"
    }
}
