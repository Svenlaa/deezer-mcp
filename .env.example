# Deezer credentials — copy the refresh-token cookie value from your browser
# (deezer.com → dev tools → cookies) after logging in. See the deezer project
# README for details. The token alone authenticates; no arl needed.
DEEZER_REFRESH_TOKEN=
# Optional: Deezer account id used for the ?host= attribution on share links.
# Defaults to me.id from the pipe API.
# DEEZER_USER_ID=

# MCP HTTP transport
MCP_PORT=3000
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_AUTH_TOKEN=
